     target_compile_definitions(${COMPONENT_LIB} PRIVATE INKBOY_DIAGNOSTICS=1)
     target_sources(${COMPONENT_LIB} PRIVATE "diagnostics.c")
 endif()
+
+# Games preloaded into internal flash, used when no SD card is inserted.
+# Put .gb files in internal_fs/roms/ (git-ignored except the README).
+set(INTERNAL_FS "${CMAKE_SOURCE_DIR}/internal_fs")
+if(EXISTS "${INTERNAL_FS}/roms")
+    fatfs_create_spiflash_image(storage "${INTERNAL_FS}" FLASH_IN_PROJECT PRESERVE_TIME)
+endif()
