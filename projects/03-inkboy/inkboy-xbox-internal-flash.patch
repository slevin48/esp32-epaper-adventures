 static uint32_t now_ms(void) { return (uint32_t)(esp_timer_get_time()/1000); }
 
+/* Raw bits in the custom controller's layout, so the default mapping applies. */
+enum { RAW_DOWN = 0x01, RAW_LEFT = 0x02, RAW_UP = 0x04, RAW_RIGHT = 0x08,
+       RAW_SELECT = 0x10, RAW_B = 0x20, RAW_A = 0x40, RAW_START = 0x80 };
+
+static bool is_xbox_name(const char *name) { return name && strncmp(name, "Xbox", 4) == 0; }
+
+/* Xbox Wireless Controller over BLE (firmware 5.x), input report 1:
+ * LX LY RX RY LT RT as little-endian u16, then hat (1 = N, clockwise, 0 = centre),
+ * buttons (A 0x01, B 0x02, X 0x08, Y 0x10, LB 0x40, RB 0x80),
+ * buttons (View 0x04, Menu 0x08, Xbox 0x10, LS 0x20, RS 0x40), Share 0x01.
+ * Face buttons follow the Game Boy layout: Xbox A and Y are GB A, B and X are GB B.
+ * The left stick also works as a D-pad. */
+static uint8_t xbox_buttons(const uint8_t *d, size_t length)
+{
+    if (length < 15) return 0;
+    uint8_t raw = 0;
+    static const uint8_t hat[9] = {0, RAW_UP, RAW_UP | RAW_RIGHT, RAW_RIGHT, RAW_DOWN | RAW_RIGHT,
+                                   RAW_DOWN, RAW_DOWN | RAW_LEFT, RAW_LEFT, RAW_UP | RAW_LEFT};
+    if (d[12] <= 8) raw |= hat[d[12]];
+    uint16_t lx = d[0] | d[1] << 8, ly = d[2] | d[3] << 8;  /* 0..65535, centre 32768 */
+    if (lx < 16384) raw |= RAW_LEFT;
+    if (lx > 49152) raw |= RAW_RIGHT;
+    if (ly < 16384) raw |= RAW_UP;
+    if (ly > 49152) raw |= RAW_DOWN;
+    if (d[13] & (0x01 | 0x10)) raw |= RAW_A;
+    if (d[13] & (0x02 | 0x08)) raw |= RAW_B;
+    if (d[14] & 0x04) raw |= RAW_SELECT;
+    if (d[14] & 0x08) raw |= RAW_START;
+    return raw;
+}
+
+static void store_buttons(uint8_t buttons)
+{
+    uint32_t previous = atomic_exchange(&raw_buttons, buttons);
+    atomic_store(&last_report_ms, now_ms());
+    atomic_fetch_add(&reports, 1);
+    if (previous != buttons) ESP_LOGI(TAG, "PAD_BUTTONS,%02x", buttons);
+}
